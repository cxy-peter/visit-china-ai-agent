# Copy to .env on your own computer. Never commit .env.
HOST=127.0.0.1
PORT=8787
ADMIN_PASSWORD=demo2026
# Uncomment and replace locally, or configure in Operations for this process.
# DEEPSEEK_API_KEY=replace-locally
DEEPSEEK_MODEL=deepseek-flash
MAX_MODEL_CALLS_PER_HOUR=60
# Optional random visitor access code, at least 16 characters (not the API key).
# DEMO_ACCESS_TOKEN=replace-with-a-long-random-code

# LiveKit Cloud: audio is sent only after an authorized caller consents.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=replace-locally
# LIVEKIT_API_SECRET=replace-locally
VOICE_BACKEND_URL=http://127.0.0.1:8787
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_STT_LANGUAGE=multi
LIVEKIT_TTS_MODEL=cartesia/sonic-3
LIVEKIT_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
# Optional organization SSO. HTTPS is mandatory; never use emails as subjects.
# OIDC_ISSUER=https://your-identity-provider.example
# OIDC_CLIENT_ID=replace-locally
# OIDC_CLIENT_SECRET=replace-locally
# OIDC_REDIRECT_URI=https://your-app.example/api/v5/auth/callback
# OIDC_ADMIN_SUBJECTS=["immutable-admin-subject"]
# OIDC_REVIEWER_SUBJECTS=["subject-1","subject-2","subject-3","subject-4","subject-5"]
# Persistent local disk, shared only by processes on the same host:
# LOCAL_DATA_DIR=/persistent/visit-china
